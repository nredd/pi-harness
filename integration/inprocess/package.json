{
	"name": "@nredd/pi-stack-tests",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "biome check --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"test": "node ../../scripts/run-vitest.ts node --coverage",
		"test:bun": "node ../../scripts/run-vitest.ts bun --coverage --coverage.provider=istanbul --coverage.reporter=text --coverage.reporter=lcov --coverage.reportsDirectory=coverage/bun",
		"check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-coding-agent-1.3.0.tgz",
		"@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-tui-1.3.0.tgz",
		"@juicesharp/rpiv-config": "2.13.9",
		"@juicesharp/rpiv-i18n": "2.13.9",
		"@narumitw/pi-tui-kit": "0.65.5",
		"@quintinshaw/pi-dynamic-workflows": "3.14.0",
		"@types/node": "26.6.5",
		"@vitest/coverage-istanbul": "5.0.3",
		"@xterm/headless": "5.5.0",
		"croner": "10.0.1",
		"nanoid": "5.1.16",
		"pi-deferred-context-engine": "0.5.0",
		"pi-memory": "0.4.2",
		"pi-web-access": "0.43.0",
		"typebox": "1.3.36",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
