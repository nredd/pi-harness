{
  "name": "@nredd/pi-preset",
  "version": "0.2.0",
  "publishConfig": {"access": "public"},
  "description": "Optional, opinionated Pi preset: specialist agents, reusable workflow skills, expanded footer, themes, and public-safe settings defaults.",
  "author": "nredd",
  "license": "MIT AND Apache-2.0 AND CC-BY-SA-4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/preset"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "agents/",
    "extensions/",
    "lib/",
    "licenses/",
    "settings/",
    "skills/",
    "themes/",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "lint": "biome check extensions/ lib/ test/",
    "format": "biome check --write extensions/ lib/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-tui-1.3.0.tgz",
    "@types/node": "26.6.5",
    "@xterm/headless": "5.5.0",
    "typebox": "1.3.36",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": [
      "./extensions/expanded-footer.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "piPreset": {
    "externalResources": {
      "skills": [
        {
          "name": "codebase-design",
          "requiredBy": [
            "agents/architect.md"
          ],
          "source": "https://github.com/mattpocock/skills",
          "path": "skills/engineering/codebase-design",
          "revision": "5b15a47f2d7150f545fbcacbfe381787fc0230dc",
          "license": "MIT"
        },
        {
          "name": "diagnosing-bugs",
          "requiredBy": [
            "agents/debugger.md"
          ],
          "source": "https://github.com/mattpocock/skills",
          "path": "skills/engineering/diagnosing-bugs",
          "revision": "5b15a47f2d7150f545fbcacbfe381787fc0230dc",
          "license": "MIT"
        }
      ],
      "extensions": [
        {
          "name": "pi-dev-tools",
          "requiredBy": [
            "agents/architect.md",
            "agents/code-reviewer.md",
            "agents/critic.md",
            "agents/verifier.md"
          ],
          "package": "@nredd/pi-dev-tools",
          "selectorForm": "short-name"
        },
        {
          "name": "pi-web-access",
          "requiredBy": [
            "agents/researcher.md"
          ],
          "package": "pi-web-access",
          "selectorForm": "short-name"
        }
      ]
    }
  }
}
