{
  "name": "@nredd/pi-preset",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared Pi specialist agents and workflow skills, with an optional expanded footer, themes, and public-safe settings defaults.",
  "author": "nredd",
  "license": "MIT AND Apache-2.0 AND CC-BY-SA-4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/preset"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "agents/",
    "src/",
    "CHANGELOG.md",
    "licenses/",
    "settings/",
    "skills/",
    "themes/",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-vitest.ts node --coverage",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "check": "uv run --locked --project ../../tests/integration python ../../scripts/package_contracts.py --packed-files-only --package preset && npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.12/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.12/earendil-works-pi-tui-1.3.0.tgz",
    "@nredd/pi-subagents": "0.22.0-nredd.10",
    "@nredd/pi-test-lib": "0.0.0",
    "@xterm/headless": "5.5.0",
    "typebox": "1.3.36"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "piPreset": {
    "externalResources": {
      "skills": [
        {
          "name": "codebase-design",
          "requiredBy": [
            "agents/architect.md"
          ],
          "source": "https://github.com/mattpocock/skills",
          "path": "skills/engineering/codebase-design",
          "revision": "5b15a47f2d7150f545fbcacbfe381787fc0230dc",
          "license": "MIT"
        },
        {
          "name": "diagnosing-bugs",
          "requiredBy": [
            "agents/debugger.md"
          ],
          "source": "https://github.com/mattpocock/skills",
          "path": "skills/engineering/diagnosing-bugs",
          "revision": "5b15a47f2d7150f545fbcacbfe381787fc0230dc",
          "license": "MIT"
        }
      ],
      "extensions": [
        {
          "name": "pi-dev-tools",
          "requiredBy": [
            "agents/architect.md",
            "agents/code-reviewer.md",
            "agents/critic.md",
            "agents/principal-investigator.md",
            "agents/verifier.md"
          ],
          "package": "@nredd/pi-dev-tools",
          "selectorForm": "short-name"
        },
        {
          "name": "pi-web-access",
          "requiredBy": [
            "agents/architect.md",
            "agents/principal-investigator.md",
            "agents/researcher.md"
          ],
          "package": "pi-web-access",
          "selectorForm": "short-name"
        }
      ]
    }
  }
}
