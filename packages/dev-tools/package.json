{
  "name": "@nredd/pi-dev-tools",
  "version": "0.5.2",
  "publishConfig": {"access": "public"},
  "description": "Typed pi tools for git, ssh, Python (uv/ruff/ty/pytest) and Rust (cargo): compact structured results, explicit exit-code states, no-shell spawn, bounded output.",
  "author": "nredd",
  "license": "MIT",
  "type": "module",
  "files": ["src", "LICENSE", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/dev-tools"
  },
  "keywords": ["pi-package", "pi-extension"],
  "dependencies": {
    "@nredd/pi-resource-sampler": "0.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "lint": "biome check src/ test/",
    "format": "biome check --write src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test test/scenarios",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@types/node": "26.6.5",
    "typebox": "1.3.36",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
