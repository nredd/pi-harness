{
  "name": "@nredd/pi-dev-tools",
  "version": "0.8.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Typed pi tools for git, ssh, Python (uv/ruff/ty/pytest) and Rust (cargo): compact structured results, explicit exit-code states, no-shell spawn, bounded output.",
  "author": "nredd",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/dev-tools"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "dependencies": {
    "@nredd/pi-resource-sampler": "0.2.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "JITI_FS_CACHE=false vitest run --coverage",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-coding-agent-1.3.0.tgz",
    "typebox": "1.3.36"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
