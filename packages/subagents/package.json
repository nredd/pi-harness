{
  "name": "@nredd/pi-subagents",
  "version": "0.22.0-nredd.10",
  "description": "A pi extension that brings Claude Code-like sub-agents and workflow orchestration to pi — parallel execution, live widget, fleet view, custom agent types, mid-run steering, dynamic workflows, Claude Code compatibility, look and feel.",
  "author": "tintinweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/subagents"
  },
  "homepage": "https://github.com/nredd/pi-harness/tree/main/packages/subagents#readme",
  "bugs": {
    "url": "https://github.com/nredd/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agent",
    "autonomous"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0",
    "typebox": "*"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "nanoid": "^5.1.16"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:runtime-scripts": "node ../../scripts/run-vitest.ts node --config vitest.runtime-build.config.ts --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test": "node ../../scripts/run-vitest.ts node --coverage",
    "test:watch": "JITI_FS_CACHE=false vitest",
    "test:e2e": "JITI_FS_CACHE=false vitest run e2e --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/ scripts/ vitest.runtime-build.config.ts",
    "lint:fix": "biome check --fix src/ test/ scripts/ vitest.runtime-build.config.ts",
    "check": "npm run lint && npm run typecheck && npm run check:runtime && npm run test:runtime-scripts && npm run test && npm run test:workflow-examples && npm run test:bun",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "test:workflow-examples": "node ../../scripts/run-vitest.ts node --config vitest.workflow-examples.config.ts --coverage && node ../../scripts/run-vitest.ts bun --config vitest.workflow-examples.config.ts --coverage.reportsDirectory=coverage/workflow-examples-bun",
    "test:coverage": "node ../../scripts/run-vitest.ts node --coverage",
    "bench": "JITI_FS_CACHE=false vitest bench",
    "bench:ab": "node test/perf/ab.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-ai-1.3.0.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-tui-1.3.0.tgz",
    "@nredd/pi-test-lib": "0.0.0",
    "@sinclair/typebox": "^0.34.49",
    "@vitest/istanbul-lib-coverage": "1.0.2",
    "@vitest/istanbul-lib-instrument": "1.0.2",
    "@xterm/headless": "5.5.0",
    "typebox": "^1.3.27"
  },
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ],
    "video": "https://github.com/tintinweb/pi-subagents/raw/master/media/demo.mp4",
    "image": "https://github.com/tintinweb/pi-subagents/raw/master/media/screenshot.png"
  }
}
