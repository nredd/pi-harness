{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nredd/pi-harness#873: `.js` import specifiers, unchecked indexed access and parameter properties go with the rewrite
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": false,
    "rootDir": "."
  },
  "include": ["src", "test", "*.ts"]
}
