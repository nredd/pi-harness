{
  "name": "@nredd/pi-plan-mode",
  "version": "0.59.3-nredd.4",
  "description": "Pi extension that adds a Codex-like read-only /plan collaboration mode.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "narumiruna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/plan-mode"
  },
  "homepage": "https://github.com/nredd/pi-harness/tree/main/packages/plan-mode#readme",
  "bugs": {
    "url": "https://github.com/nredd/pi-harness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "plan-mode",
    "planning"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run test:dist && npm run build && biome check . && npm run typecheck && npm test && npm run test:bun",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "JITI_FS_CACHE=false vitest run --coverage",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "test:dist": "JITI_FS_CACHE=false vitest run --config vitest.runtime-build.config.ts --coverage",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-tui-1.3.0.tgz",
    "@xterm/headless": "5.5.0",
    "semver": "7.8.5"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui": "$@earendil-works/pi-tui",
    "@earendil-works/pi-agent-core": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-agent-core-1.3.0.tgz",
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-ai-1.3.0.tgz"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.65.2"
  }
}
