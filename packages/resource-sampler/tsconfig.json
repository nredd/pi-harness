{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nredd/pi-harness#878: the one package that emits with `tsc`. `.ts` specifiers plus `rewriteRelativeImportExtensions`
    // rewrite `dist/*.js` but leave `.ts` specifiers in `dist/*.d.ts`, which a consumer's compiler cannot resolve. So it keeps
    // `.js` specifiers on Node ESM resolution, and constructor parameter properties rule out `erasableSyntaxOnly`.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "erasableSyntaxOnly": false
  },
  "include": ["src", "tests", "*.ts"]
}
