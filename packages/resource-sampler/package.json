{
  "name": "@nredd/pi-resource-sampler",
  "version": "0.2.1",
  "description": "Bounded, privacy-safe host resource interval sampling without Pi dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "nredd",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/resource-sampler"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "JITI_FS_CACHE=false vitest run --coverage --maxWorkers=1",
    "test:bun": "node ../../scripts/run-vitest.ts bun --maxWorkers=1",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:bun"
  }
}
