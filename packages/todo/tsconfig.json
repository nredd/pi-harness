{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// nredd/pi-harness#874: Node16 resolution, bun types, the upstream test-utils alias, unchecked indexed access and parameter properties go with the layout move
		"module": "Node16",
		"moduleResolution": "Node16",
		"esModuleInterop": true,
		"noUncheckedIndexedAccess": false,
		"erasableSyntaxOnly": false,
		"verbatimModuleSyntax": false,
		"types": ["node", "bun"],
		"paths": {
			"@juicesharp/rpiv-test-utils": ["./.test-support/upstream/index.ts"]
		}
	},
	"include": ["*.ts", "state/**/*.ts", "tool/**/*.ts", "view/**/*.ts", ".test-support/**/*.ts"],
	"exclude": ["node_modules"]
}
