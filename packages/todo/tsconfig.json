{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // nredd/pi-harness#874: Compatibility with upstream types: Node16 resolution, unchecked indexed access and parameter properties
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "paths": {
      "@juicesharp/rpiv-test-utils": ["./tests/fixtures/upstream/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
