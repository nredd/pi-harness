{
  "name": "@nredd/pi-subscription-router",
  "version": "0.6.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Pi virtual models that route across included subscription quota: Anthropic and ChatGPT Codex usage collectors, confirmed per-family exhaustion, and mid-run quota recovery.",
  "author": "nredd",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "examples",
    "schemas",
    "docs/policies.md",
    "docs/fairness.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/subscription-router"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-vitest.ts node --coverage",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-ai-1.3.0.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@nredd/pi-test-lib": "0.0.0",
    "typebox": "1.3.27"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
