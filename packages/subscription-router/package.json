{
  "name": "@nredd/pi-subscription-router",
  "version": "0.3.0",
  "publishConfig": {"access": "public"},
  "description": "Pi virtual models that route across included subscription quota: Anthropic and ChatGPT Codex usage collectors, confirmed per-family exhaustion, and mid-run quota recovery.",
  "author": "nredd",
  "license": "MIT",
  "type": "module",
  "files": ["src", "CHANGELOG.md", "LICENSE", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/subscription-router"
  },
  "keywords": ["pi-package", "pi-extension"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "lint": "biome check src/ test/ e2e/",
    "format": "biome check --write src/ test/ e2e/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun test test/scenarios",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.4/earendil-works-pi-ai-1.3.0.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.4/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@types/node": "26.6.3",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}
