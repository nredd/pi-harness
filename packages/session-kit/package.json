{
  "name": "@nredd/pi-session-kit",
  "version": "0.7.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Session-scoped pi tools and commands, offline cross-machine usage stats and a portable privacy-only stats CLI. No daemon.",
  "author": "nredd",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "dist/pi-stats-export.mjs",
    "docs/stats-snapshots.md",
    "docs/mon-dashboard.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nredd/pi-harness.git",
    "directory": "packages/session-kit"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "dependencies": {
    "@nredd/pi-resource-sampler": "0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "lint": "biome check src/ test/",
    "format": "biome check --write src/ test/",
    "typecheck": "tsc --noEmit",
    "build:stats-export": "esbuild src/stats/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/pi-stats-export.mjs",
    "test": "npm run build:stats-export && vitest run",
    "test:bun": "bun test test/scenarios",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.7/earendil-works-pi-tui-1.3.0.tgz",
    "@types/node": "26.6.5",
    "@xterm/headless": "5.5.0",
    "esbuild": "0.28.2",
    "typebox": "1.3.36",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
