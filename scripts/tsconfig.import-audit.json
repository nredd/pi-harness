{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "types": ["node"]
  },
  "files": [
    "check-test-matchers.ts",
    "tests/check-test-matchers.test.ts",
    "merge-pr.ts",
    "merge-pr.test.ts",
    "coverage-configs.test.ts",
    "import_audit.ts",
    "import_audit.test.ts",
    "run-vitest.ts",
    "run-vitest.test.ts",
    "vitest.config.ts",
    "vitest-package.ts"
  ]
}
