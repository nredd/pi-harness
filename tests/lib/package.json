{
  "name": "@nredd/pi-test-lib",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test helpers: fake clock, promise gates, faux turns, terminal constants, home guard. Imports no package under packages/.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-vitest.ts node --coverage",
    "test:bun": "node ../../scripts/run-vitest.ts bun",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:bun"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-agent-core-1.3.0.tgz",
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-ai-1.3.0.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-coding-agent-1.3.0.tgz",
    "typebox": "1.3.36"
  }
}
