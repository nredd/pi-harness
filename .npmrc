# Bounded retry for transient registry/release-CDN failures (e.g. a GitHub 504) in every root and
# workspace `npm ci`. Backoff is min(mintimeout * factor^n, maxtimeout): 5s, 10s, 20s, then 30s,
# at most 155s of waiting per request, the same window as `release.fetch_bytes`. See docs/releases.md.
fetch-retries=7
fetch-retry-factor=2
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=30000
