{
  "name": "pi-harness",
  "private": true,
  "type": "module",
  "description": "Development monorepo for owned Pi plugins, integration tests, and benchmarks.",
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "packages/*",
    "integration/inprocess",
    "tests/lib"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run check --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "nanoid": "5.1.16",
    "semver": "7.8.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "pi-web-access": {
      "@modelcontextprotocol/sdk": "1.32.1"
    },
    "@earendil-works/pi-coding-agent": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-coding-agent-1.3.0.tgz",
    "@earendil-works/pi-tui": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-tui-1.3.0.tgz",
    "@earendil-works/pi-agent-core": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-agent-core-1.3.0.tgz",
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.11/earendil-works-pi-ai-1.3.0.tgz"
  }
}
