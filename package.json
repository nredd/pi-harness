    "@earendil-works/pi-agent-core": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.4/earendil-works-pi-agent-core-1.3.0.tgz",
    "@earendil-works/pi-ai": "https://github.com/nredd/pi/releases/download/v1.3.0-nredd.4/earendil-works-pi-ai-1.3.0.tgz"
  }
